# ========================================
# TMS App - Git Ignore Configuration
# Only track frontend/ and backend/ folders
# ========================================

# Ignore everything at root level
/*

# Exception: Allow only these folders
!frontend/
!backend/
!.gitignore
!.github/

# Exception: Allow security and documentation files at root
!VULNERABILITY_FIX_ROADMAP.md
!README.md
!LICENSE

# ========== Python Cache & Compiled Files ==========
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Django stuff
*.log
local_settings.py
db.sqlite3
db.sqlite3-journal

# Database backup files (pg_dump) — never commit backup binaries to git
backend/backups/

# Static and media files (generated/uploaded)
staticfiles/
media/

# Virtual environments
venv/
env/
ENV/
.venv
backend/venv/

# ========== Node & Angular ==========
# Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Angular build outputs
dist/
tmp/
out-tsc/
.angular/

# IDEs and editors
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store

# ========== Environment Files ==========
# SECURITY: Never commit environment files with secrets
.env
.env.local
.env.production
.env.*.local

# ========== OS Files ==========
Thumbs.db
Desktop.ini
CODE_STANDARDS_AND_REFACTORING_GUIDE.md
*.md
