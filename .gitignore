# ========================================
# TMS App - Git Ignore Configuration
# ========================================

# ========== Documentation Files ==========
# Exclude all markdown documentation files
*.md
!README.md
!backend/README.md
!frontend/README.md

# ========== Test & Migration Scripts ==========
# Python test scripts
test_*.py
*_test.py
create_admin.py
migrate_*.py

# CSV exports
*.csv
event_types_export.csv

# ========== Submodules & External Projects ==========
# Exclude pctsb.syntra submodule content
pctsb.syntra/
pctsb.syntra
Claude Code v2.0.21.txt
Claude*.txt

# ========== Python Cache & Compiled Files ==========
# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Django stuff
*.log
local_settings.py
db.sqlite3
db.sqlite3-journal

# Virtual environments
venv/
env/
ENV/
.venv
backend/venv/
frontend/node_modules/

# ========== Node & Angular ==========
# Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Angular build outputs
dist/
tmp/
out-tsc/
.angular/

# IDEs and editors
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store

# ========== Environment Files ==========
.env
.env.local
.env.*.local

# ========== OS Files ==========
Thumbs.db
Desktop.ini
nul

# ========== Temporary Files ==========
*.bat
*.tmp

# ========== Keep These Directories ==========
# Force include important directories
!backend/
!frontend/
