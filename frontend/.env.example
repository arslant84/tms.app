# TMS Frontend Environment Configuration
# Copy this file to .env for local development
# Note: Angular uses environment.ts files, not .env files
# This file is for documentation purposes

# ======================================
# API Configuration
# ======================================
# Backend API URL (configured in src/environments/environment.ts)
# Development: http://localhost:8000/api
# Production: https://api.your-domain.com/api

# ======================================
# Build Configuration
# ======================================
# NODE_ENV=development
# NG_BUILD_CACHE=true

# ======================================
# Feature Flags (if implemented)
# ======================================
# ENABLE_ANALYTICS=false
# ENABLE_ERROR_TRACKING=false

# ======================================
# Important Notes
# ======================================
# Angular uses TypeScript environment files, not .env files.
# Configure your environment in:
#   - src/environments/environment.ts (development)
#   - src/environments/environment.prod.ts (production)
#
# Example environment.ts:
# export const environment = {
#   production: false,
#   apiUrl: 'http://localhost:8000/api'
# };
