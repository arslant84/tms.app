# TMS backend maintenance schedule — example crontab
#
# This file documents the intended schedule and doubles as a manual
# fallback. The preferred install method is the self-installing management
# command, which writes this same schedule into the crontab directly and is
# safe to re-run (idempotent, tagged entries):
#
#   python manage.py install_cron
#   python manage.py install_cron --dry-run   # preview without writing
#   python manage.py install_cron --remove    # uninstall
#
# Manual install (only if the deploying user can't run manage.py commands
# directly on the host):
#   crontab -e
#   # then paste the lines below, adjusting REPO_PATH and VENV_PATH for your
#   # deployment, or:
#   crontab backend/scripts/crontab.example   # after editing the paths
#
# All commands log to backend/logs/ so cron failures are visible without
# relying on cron's own (often misconfigured) mail delivery.

REPO_PATH=/path/to/tms-app/backend
VENV_PATH=/path/to/tms-app/backend/venv

# Daily database backup — 02:00
0 2 * * * cd $REPO_PATH && $VENV_PATH/bin/python manage.py backup_db >> logs/cron_backup_db.log 2>&1

# Weekly inactive-account disable (90-day threshold by default) — Sunday 03:00
0 3 * * 0 cd $REPO_PATH && $VENV_PATH/bin/python manage.py disable_inactive_accounts >> logs/cron_disable_inactive_accounts.log 2>&1

# Monthly data retention cleanup (7-year default, or ApplicationSetting
# 'data_retention_days') — 1st of the month, 04:00
0 4 1 * * cd $REPO_PATH && $VENV_PATH/bin/python manage.py cleanup_expired_data >> logs/cron_cleanup_expired_data.log 2>&1

# Hourly workflow step reminder notifications (due within 24h, one-shot) — top of every hour
0 * * * * cd $REPO_PATH && $VENV_PATH/bin/python manage.py send_step_reminders >> logs/cron_send_step_reminders.log 2>&1

# External uptime check — every 5 minutes. Emails UPTIME_ALERT_EMAIL (.env)
# after 2 consecutive failed checks and once more on recovery. No-op if
# UPTIME_ALERT_EMAIL is unset.
*/5 * * * * cd $REPO_PATH && $VENV_PATH/bin/python manage.py check_uptime >> logs/cron_check_uptime.log 2>&1
