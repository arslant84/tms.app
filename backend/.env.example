# =============================================================================
# TMS Environment Configuration
# =============================================================================
# Copy this file to .env and update with your actual values
# =============================================================================

# Django Settings
SECRET_KEY=your-secret-key-here-generate-new-one
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database Configuration
DB_ENGINE=django.db.backends.postgresql
DB_NAME=tms
DB_USER=postgres
DB_PASSWORD=your-database-password-here
DB_HOST=localhost
DB_PORT=5432

# Email Configuration - Brevo SMTP
# Get your Brevo SMTP credentials from: https://app.brevo.com/settings/keys/smtp
# Custom backend provides better SSL/TLS handling
EMAIL_BACKEND=utils.email_backend.CustomEmailBackend
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=your-brevo-login-email@example.com
EMAIL_HOST_PASSWORD=your-brevo-smtp-key-here
DEFAULT_FROM_EMAIL=SynTra TMS <noreply@yourdomain.com>

# Frontend URL - Used in password reset emails and notifications
# Development: http://localhost:4200
# Production: https://yourdomain.com
FRONTEND_URL=http://localhost:4200

# CORS Settings
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200

# Security Settings (Set to False for development, True for production)
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False

# Content Security Policy (Production)
# URL of your production backend API for CSP connect-src directive
# CSP_BACKEND_URL=https://api.yourdomain.com

# =============================================================================
# Security Gap Remediation Settings
# =============================================================================

# Field-level encryption key for sensitive personal data at rest (CTRL-0000001066).
# REQUIRED in production. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=your-fernet-key-here-generate-new-one

# SIEM log output directory (CTRL-0000001356).
# Point your SIEM agent (Splunk, Elastic Filebeat, Sentinel) at <dir>/security.json.
# Defaults to <BASE_DIR>/logs/ if not set.
# SIEM_LOG_DIR=/var/log/tms

# Data retention period in days for personal data disposal (CTRL-0000001517).
# Default: 2555 days (7 years). Set via ApplicationSetting or override here.
# DATA_RETENTION_DAYS=2555

# Privacy policy version string shown to users at registration (CTRL-0000001000/1001/1003).
PRIVACY_POLICY_VERSION=1.0

# =============================================================================
# MinIO Object Storage (media files)
# =============================================================================
# MinIO server listens on port 9000 (API) and 9001 (console)
# nginx must proxy https://<MINIO_PUBLIC_DOMAIN>/<MINIO_BUCKET_NAME>/ → http://127.0.0.1:9000/<bucket>/
MINIO_ACCESS_KEY=tmsadmin
MINIO_SECRET_KEY=your-minio-password-here
MINIO_BUCKET_NAME=tms-media
MINIO_ENDPOINT_URL=http://127.0.0.1:9000
MINIO_PUBLIC_DOMAIN=yourdomain.com
